#!/bin/sh
set -e

if [ "$1" = "install" ] || [ "$1" = "upgrade" ]; then
    # Force remove any existing diversion (in case of incomplete previous installations)
    dpkg-divert --remove --package adaptation-crownqltechn-configs \
        --divert /usr/bin/usb-tethering.hybris /usr/bin/usb-tethering 2>/dev/null || true
    
    # Register the diversion before unpacking files
    dpkg-divert --add --package adaptation-crownqltechn-configs --force --rename \
        --divert /usr/bin/usb-tethering.hybris /usr/bin/usb-tethering
fi
